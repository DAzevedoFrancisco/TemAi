# Django (desenvolvimento local)
SECRET_KEY=dev-change-me-before-production
DEBUG=True
MOB_NETWORK_DEV=true

# Testar no telemóvel (hotspot): coloca o IPv4 do notebook (ipconfig)
# ALLOWED_HOSTS=localhost,127.0.0.1,10.86.143.252
# CSRF_TRUSTED_ORIGINS=http://10.86.143.252:8000

# Base de dados local (MySQL)
# Em produção no Render usa-se DATABASE_URL (PostgreSQL) — não definir aqui.
DB_NAME=mob
DB_USER=root
DB_PASSWORD=0008
DB_HOST=127.0.0.1
DB_PORT=3306
# Reutilização de ligações (local MySQL e produção/Render via DATABASE_URL)
DB_CONN_MAX_AGE=60

# Cloudinary (opcional em local — sem credenciais, imagens ficam em media/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin: nunca promovido no registo. Use:
